# JalDrishti AI Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true

# Database
# For local SQLite: sqlite:///./jaldrishti.db
# For Docker / PostGIS: postgresql+psycopg2://postgres:postgrespassword@localhost:5432/jaldrishti_db
DATABASE_URL=sqlite:///./jaldrishti.db

# Cache / Celery Broker
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Frontend URL for CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
