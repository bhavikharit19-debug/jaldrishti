# JalDrishti Backend Production Environment Configuration
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=JalDrishti
VERSION=1.0.0
API_V1_STR=/api/v1

# Production PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@db:5432/jaldrishti_db

# Cryptographic Token Signing Secret
SECRET_KEY=jaldrishti_secret_gov_auth_2026_sih_secure_rotate_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Allowed Origins
CORS_ORIGINS=["https://jaldrishti.gov.in","https://app.jaldrishti.gov.in","*"]

STORAGE_TYPE=local
UPLOAD_DIR=/app/uploads
