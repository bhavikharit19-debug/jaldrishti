# JalDrishti AI - Environment Configuration Example
PROJECT_NAME="JalDrishti"
ENVIRONMENT="production"
DEBUG=false
PORT=8000

# Database
DATABASE_URL="postgresql://user:password@hostname:5432/jaldrishti"

# JWT Stateless Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS='["https://jaldrishti-web.onrender.com"]'

# Storage
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
